@startuml
skinparam style strictuml
skinparam monochrome true

actor "Customer" as User
participant "Frontend\n(checkout.js)" as Client
participant "Cart\n(Cart Class)" as Cart
participant "Backend\n(server.js)" as Server
participant "Entities\n(Order, User)" as Entities

User -> Client : Clicks "Confirm Order"
activate Client

Client -> Cart : getTotalItemsCount()
activate Cart
Cart --> Client : count
deactivate Cart

alt If cart is empty (count == 0)
    Client --> User : Show error "Your cart is empty"
else Cart is not empty
    Client -> Server : POST request with formData
    activate Server
    
    Server -> Server : Data Validation (validator.js)
    
    Server -> Entities : Create Order, User, Payment objects
    activate Entities
    Entities --> Server : Objects created
    deactivate Entities
    
    Server -> Entities : getEstimatedDeliveryDate() (via date-fns)
    activate Entities
    Entities --> Server : Delivery Date
    deactivate Entities
    
    Server --> Client : 200 OK (orderId, totalPaid, estimatedDelivery)
    deactivate Server
    
    Client -> Cart : clearCart() (or remove from localStorage)
    activate Cart
    Cart --> Client : Cart cleared
    deactivate Cart
    
    Client --> User : Success Message + Delivery Date
end

deactivate Client
@enduml