@startuml
skinparam style strictuml
left to right direction
skinparam packageStyle rectangle
skinparam monochrome true

actor "Customer" as Customer
actor "Backend (Express Server)" as System

rectangle "Flower Shop Web App" {
  usecase "View Catalog" as UC_Catalog
  usecase "Filter & Search" as UC_Filter
  usecase "Build Custom Bouquet" as UC_Builder
  usecase "Manage Cart" as UC_Cart
  usecase "Checkout" as UC_Checkout
  usecase "Process Payment" as UC_Payment
  usecase "Calculate Assembly Cost (MST)" as UC_Calc
}

' User Actions
Customer --> UC_Catalog
Customer --> UC_Builder
Customer --> UC_Cart
Customer --> UC_Checkout

' Extensions and Includes
UC_Catalog <.. UC_Filter : <<extend>>
UC_Builder ..> UC_Calc : <<include>>
UC_Checkout ..> UC_Payment : <<include>>

' System Actions
UC_Calc <-- System
UC_Payment <-- System

@enduml