@startuml
skinparam style strictuml
skinparam monochrome true

package "Flower Shop System" {
    component "Frontend UI\n(HTML, CSS)" as UI
    component "Client Logic\n(cart.js, builder.js)" as ClientLogic
    
    package "Backend (Node.js)" {
        component "Express REST API\n(server.js)" as API
        component "Business Entities\n(Order, Bouquet, etc.)" as Models
        component "Algorithms\n(graph.js)" as Utils
    }
}

UI --> ClientLogic : "User Interaction"
ClientLogic --> API : "HTTP fetch requests"
API --> Models : "Creates Objects"
API --> Utils : "Calculates MST"
@enduml